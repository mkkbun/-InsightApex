# ─────────────────────────────────────────────────────────
# InsightApex — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
# Local example: postgresql://postgres:password@localhost:5432/insightapex
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/insightapex?schema=public"

# ── Auth.js (NextAuth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── App URL (used in email links — must match your dev server port) ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
# With a verified domain (e.g. insightapex.co.uk), set From to that domain:
#   EMAIL_FROM="InsightApex <noreply@insightapex.co.uk>"
# Using onboarding@resend.dev limits delivery to your Resend account email only.
RESEND_API_KEY=""
EMAIL_FROM="InsightApex <noreply@insightapex.co.uk>"

# ── File Storage (Cloudflare R2) ──────────────────────────
# Needed only when uploading question images or certificates.
# R2 is S3-compatible; use the @aws-sdk/client-s3 package.
R2_ENDPOINT=""              # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="insightapex"
R2_PUBLIC_BASE_URL=""       # e.g. https://cdn.insightapex.com

# ── Payments (Stripe — test mode only) ───────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
